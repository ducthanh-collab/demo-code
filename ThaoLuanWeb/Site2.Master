<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site2.master.cs" Inherits="ThaoLuanWeb.Site2" %>
<%@ Register Src="~/Header.ascx" TagPrefix="uc" TagName="Header" %>
<%@ Register Src="~/MenuTrai.ascx" TagPrefix="uc" TagName="MenuTrai" %>
<%@ Register Src="~/BannerPhai.ascx" TagPrefix="uc" TagName="BannerPhai" %>
<%@ Register Src="~/Footer.ascx" TagPrefix="uc" TagName="Footer" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Sách Online - UserControl</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        .container {
            width: 960px;
            margin: 0 auto;
            border: 1px solid #ccc;
        }

        .header-top {
            background-color: #f0f0f0;
            padding: 15px;
            display: table;
            width: 100%;
        }

        .header-left {
            display: table-cell;
            vertical-align: middle;
            font-size: 42px;
            font-weight: bold;
            font-style: italic;
            color: #2b579a;
            font-family: 'Times New Roman', Times, serif;
            letter-spacing: -1px;
            transform: skewX(-10deg);
        }

        .header-right {
            display: table-cell;
            vertical-align: middle;
            text-align: right;
            font-size: 13px;
            color: #333;
        }

        .menu-ngang {
            background-color: #0000ff;
            list-style: none;
            display: table;
            width: 100%;
        }

        .menu-ngang li {
            display: table-cell;
            text-align: center;
            border-right: 1px solid #fff;
        }

        .menu-ngang li:last-child {
            border-right: none;
        }

        .menu-ngang li a {
            display: block;
            padding: 10px 0;
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            font-weight: bold;
        }

        .main-content {
            display: table;
            width: 100%;
            min-height: 400px;
        }

        .col-left {
            display: table-cell;
            width: 200px;
            background-color: #1e90ff;
            vertical-align: top;
            padding: 10px;
        }

        .col-left h4 {
            color: #000;
            margin-bottom: 8px;
            font-size: 13px;
            text-transform: uppercase;
        }

        .col-left ul {
            list-style: none;
            margin-bottom: 15px;
            padding-left: 10px;
        }

        .col-left ul li a {
            color: #00008b;
            text-decoration: none;
            font-size: 13px;
            line-height: 20px;
        }

        .col-center {
            display: table-cell;
            vertical-align: top;
            padding: 15px;
        }

        .col-right {
            display: table-cell;
            width: 200px;
            vertical-align: top;
            padding: 10px;
            text-align: center;
            border-left: 1px solid #ddd;
        }

        .col-right img {
            width: 100%;
            margin-bottom: 10px;
            border: 1px solid #ccc;
        }

        .footer {
            background-color: #0000ff;
            color: #fff;
            text-align: center;
            padding: 10px;
            font-size: 13px;
            font-weight: bold;
        }

        .footer a {
            color: #fff;
            text-decoration: none;
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="container">
            <uc:Header ID="HeaderControl" runat="server" />

            <div class="main-content">
                <uc:MenuTrai ID="MenuTraiControl" runat="server" />

                <div class="col-center">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </div>

                <uc:BannerPhai ID="BannerPhaiControl" runat="server" />
            </div>

            <uc:Footer ID="FooterControl" runat="server" />
        </div>
    </form>
</body>
</html>